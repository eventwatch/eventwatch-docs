  "info" : {
    "description" : "団体のサイトや道具から、EventWatch の投稿を読み書きする API です。",
    "title" : "EventWatch Organization API",
    "version" : "1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1.0/org-api/drafts" : {
      "get" : {
        "description" : "AI が作った下書きと差し戻しを新しい順に返します。例: page=0&size=20。size の上限は 100 です。編集元が外部のサイトに移った投稿は出ません。",
        "operationId" : "listDrafts",
        "parameters" : [ {
          "description" : "0 から始まるページ番号です。",
          "in" : "query",
          "name" : "page",
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "1 ページの件数です。",
          "in" : "query",
          "name" : "size",
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 100,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OwnedEventsDTO"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "organizationApiKey" : [ ]
        } ],
        "summary" : "下書きを一覧する",
        "tags" : [ "下書き" ]
      },
      "post" : {
        "description" : "下書きを作ります（201）。`Idempotency-Key` は必須で、同じ値の再送は作らずに既存の投稿を返します（200）。同じ値で中身が違うと 422（code=idempotencyKeyReused）です。値は 72 時間有効です。未提出の下書きが団体で 50 件あると 409（code=aiDraftLimitExceeded）です。",
        "operationId" : "createDraft",
        "parameters" : [ {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateOwnedEventRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OwnedEventDTO"
                }
              }
            },
            "description" : "同じ値の再送で、既存の投稿を返します。"
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OwnedEventDTO"
                }
              }
            },
            "description" : "下書きを作りました。"
          }
        },
        "security" : [ {
          "organizationApiKey" : [ ]
        } ],
        "summary" : "下書きを作る",
        "tags" : [ "下書き" ]
      }
    },
    "/api/v1.0/org-api/drafts/{eventId}" : {
      "get" : {
        "description" : "差し戻しの理由を含みます。無い・他団体・人が作った投稿は 404 です。AI が作った投稿でも、下書きと差し戻し以外は 409（code=draftNotEditable）、編集元が外部のサイトにあれば 409（code=eventManagedExternally）です。",
        "operationId" : "getDraft",
        "parameters" : [ {
          "in" : "path",
          "name" : "eventId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OwnedEventDTO"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "organizationApiKey" : [ ]
        } ],
        "summary" : "下書きを取得する",
        "tags" : [ "下書き" ]
      },
      "patch" : {
        "description" : "送った項目だけを変えます。null と省略は変えず、空（`\"\"`・`tagIds: []`）で消します。審査の状態は変えません。対象の判定は取得と同じです。",
        "operationId" : "updateDraft",
        "parameters" : [ {
          "in" : "path",
          "name" : "eventId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateAiDraftRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OwnedEventDTO"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "organizationApiKey" : [ ]
        } ],
        "summary" : "下書きを部分更新する",
        "tags" : [ "下書き" ]
      }
    },
    "/api/v1.0/org-api/events" : {
      "get" : {
        "description" : "キーの団体の投稿のうち、まだ結び付いていないもの（外部の出所が無い・切り離し中）を新しい順に返します。論理削除した投稿を除き、審査の状態と開催日では絞りません。例: page=0&size=20。size の上限は 100 です。結び付けると一覧から消えて位置がずれるので、続けて取り込むときは page=0 を読み直します。",
